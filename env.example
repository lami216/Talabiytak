APP_NAME=Product Image Manager
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=talabiytak
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/product-image-manager
MAX_EXCEL_UPLOAD_MB=100
MAX_IMAGES_PER_IMPORT=2000
MAX_SINGLE_IMAGE_MB=25
MAX_UNCOMPRESSED_IMPORT_MB=300
MAX_ZIP_ENTRIES=10000
IMAGE_MAX_WIDTH=10000
IMAGE_MAX_HEIGHT=10000
IMAGE_MAX_PIXELS=50000000
SESSION_COOKIE_NAME=product_image_session
SESSION_MAX_AGE_SECONDS=43200
TRUSTED_HOSTS=localhost,127.0.0.1
ABANDONED_IMPORT_RETENTION_DAYS=30
